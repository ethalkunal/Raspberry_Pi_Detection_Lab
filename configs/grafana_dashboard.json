        "vizConfig": {
          "group": "timeseries",
          "kind": "VizConfig",
          "spec": {
            "fieldConfig": {
              "defaults": {
                "color": {
                  "mode": "palette-classic"
                },
                "custom": {
                  "drawStyle": "bars",
                  "fillOpacity": 60,
                  "lineWidth": 1,
                  "pointSize": 5,
                  "showPoints": "never"
                },
                "thresholds": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": 0 },
                    { "color": "red", "value": 10 }
