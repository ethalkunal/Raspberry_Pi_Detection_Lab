                    },
                    "group": "loki",
                    "kind": "DataQuery",
                    "spec": {
                      "direction": "backward",
                      "editorMode": "code",
                      "expr": "sum(count_over_time({job=\"cowrie\"} | json | event_id=`cowrie.session.connect` [5m]))",
                      "queryType": "range"
                    },
                    "version": "v0"
                  },
                  "refId": "A"
